# Redmi AX6 .config 种子
#
# 这不是完整的 .config，只是差异项。scripts/build.sh 会把它拷成 .config
# 再跑 make defconfig 展开成完整配置。
#
# 基线参考上游 qosmio/openwrt-ipq 的 nss-setup/config-nss.seed，按本设备
# 的需求做了增删：保留无线（NSS WiFi 卸载 + 802.11k/v/r + Mesh），
# 增加科学上网 / DNS 过滤 / 异地组网所需的包。

# ============================================================
# 目标平台与设备
# ============================================================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6=y

# ============================================================
# 构建选项（沿用上游 NSS seed 的关键项）
# ============================================================
CONFIG_CCACHE=y
CONFIG_DEVEL=y
CONFIG_EXPERIMENTAL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53+crc+crypto"
CONFIG_USE_GC_SECTIONS=y
CONFIG_ZLIB_OPTIMIZE_SPEED=y
CONFIG_ZSTD_OPTIMIZE_O3=y

# NSS 要求内核不抢占，否则 NPU 数据面会抖
CONFIG_KERNEL_PREEMPT_NONE=y
CONFIG_KERNEL_PREEMPT_NONE_BUILD=y

# 上游 seed 默认打开的内核调试项，本固件不调试内核，关掉省时间
# CONFIG_COLLECT_KERNEL_DEBUG is not set
# CONFIG_KERNEL_DYNAMIC_DEBUG is not set

# ============================================================
# NSS 硬件卸载
# ============================================================
# kmod-qca-nss-drv / kmod-qca-nss-ecm 已是 ipq807x target.mk 的默认包，
# 这里显式声明便于审查。
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y

# PPPoE 卸载 —— 千兆 PPPoE 拨号跑满线速靠这个
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y

# 桥接与 VLAN 卸载
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y

# ============================================================
# 无线：ath11k + NSS WiFi 卸载
# ============================================================
# 驱动与固件由上游默认包带上，不需要显式声明：
#   kmod-ath11k-ahb / kmod-ath11k / ath11k-firmware-ipq8074（qualcommax/ipq807x）
#   板级射频校准数据 ipq-wifi-redmi_ax6（Device/redmi_ax6 的 DEVICE_PACKAGES）
# build.sh 会在 defconfig 后逐项校验它们确实进了 .config。

# NSS WiFi 卸载与 Mesh（对应「快速漫游 802.11k/v/r + Mesh」需求）
CONFIG_PACKAGE_kmod-qca-mcs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-wifi-meshmgr=y
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_ATH11K_NSS_MESH_SUPPORT=y
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y

# wpad：换成带 802.11k/v/r 与 Mesh 支持的完整版（默认是 wpad-basic-mbedtls）
CONFIG_PACKAGE_wpad-mesh-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# ============================================================
# DNS / 透明代理基础依赖
# ============================================================
# OpenClash 需要 dnsmasq-full（ipset / nftset 支持），默认的 dnsmasq 要换掉
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# Clash 的 TUN 模式依赖
CONFIG_PACKAGE_kmod-tun=y

# OpenClash 的 LuCI 前端依赖 luci-compat（旧版 LuCI API 兼容层）
CONFIG_PACKAGE_luci-compat=y

# ============================================================
# Web 界面（与官方默认固件一致：luci 元包）
# ============================================================
CONFIG_PACKAGE_luci=y

# ============================================================
# 中文化
#
# 不要写 CONFIG_PACKAGE_luci-i18n-xxx-zh-cn=y —— luci.mk 里这些包是
#   HIDDEN:=1
#   DEFAULT:=LUCI_LANG_$(lang)||(ALL&&m)
# HIDDEN 的符号不能在 .config 里直接选，make defconfig 会静默丢弃。
# 正确开关是语言总开关，它会让所有已选 luci 包自动带上对应语言包。
#
# 语言名取自 po 目录名 zh_Hans（不是 zh-cn，后者只是 LUCI_LC_ALIAS 出来的包名后缀）。
# ============================================================
CONFIG_LUCI_LANG_zh_Hans=y

# ============================================================
# 科学上网：OpenClash（第三方 feed，见 scripts/build.sh）
# ============================================================
CONFIG_PACKAGE_luci-app-openclash=y

# ============================================================
# DNS 去广告：AdGuard Home（官方 packages feed，自带 Web 管理界面）
# ============================================================
CONFIG_PACKAGE_adguardhome=y

# ============================================================
# 异地组网 / 内网穿透
# ============================================================
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_zerotier=y

# ============================================================
# 额外软件包
# ============================================================
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_zsh=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_nano=y

# ============================================================
# USB 存储（AX6 有一个 USB 3.0 口，便于外挂数据盘 / 扩容）
# ============================================================
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_block-mount=y
