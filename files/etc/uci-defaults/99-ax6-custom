#!/bin/sh
# 首次启动时执行一次，执行成功后自动删除。

# ---------- 界面与系统中文化 ----------
uci -q set luci.main.lang='zh_cn'
uci -q commit luci

uci -q set system.@system[0].zonename='Asia/Shanghai'
uci -q set system.@system[0].timezone='CST-8'
uci -q commit system

# ---------- 关闭与 NSS 冲突的软件卸载 ----------
# NSS 走 NPU 数据面，packet steering 和 nftables flow offload 会把流量
# 拉回 CPU，既冲突又白白丢掉硬件加速。上游 README 明确要求全部关闭。
# 这里显式置 0，是因为 sysupgrade 保留配置时这些设置会从旧固件带过来。
uci -q set network.globals.packet_steering='0'
uci -q commit network

uci -q set firewall.@defaults[0].flow_offloading='0'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
uci -q commit firewall

# ---------- 注释掉不存在的软件源 ----------
# OpenWrt 会把编译时用到的每个 feed 都写进源列表，不管上游有没有对外发布。
# nss_packages 和 sqm_scripts_nss 是 qosmio 自己的 feed，downloads.openwrt.org
# 上没有，留着会让每次 opkg update 报 "2 unavailable"。
# 24.10 用 opkg（/etc/opkg/distfeeds.conf），25.12 起改用 apk，两个路径都处理一遍。
for f in /etc/opkg/distfeeds.conf /etc/opkg/customfeeds.conf \
         /etc/apk/repositories.d/distfeeds.list; do
	[ -f "$f" ] || continue
	sed -i -E 's|^(https?://downloads\.openwrt\.org/.*/(nss_packages|sqm_scripts_nss)/.*)$|# \1|' "$f"
done

# ---------- zsh 设为 root 默认 shell ----------
ZSH_BIN="$(command -v zsh 2>/dev/null)"
if [ -n "$ZSH_BIN" ] && [ -x "$ZSH_BIN" ]; then
	grep -q "^${ZSH_BIN}\$" /etc/shells 2>/dev/null || echo "$ZSH_BIN" >> /etc/shells
	sed -i "/^root:/ s#:/bin/ash\$#:${ZSH_BIN}#" /etc/passwd
fi

# ---------- AdGuard Home 数据目录 ----------
[ -d /etc/adguardhome ] || mkdir -p /etc/adguardhome

# 说明：OpenClash / AdGuard Home / Tailscale / ZeroTier 只装不自动配置。
# 它们的 DNS 接管方式互相耦合（dnsmasq / AdGuardHome / Clash 三者都可能想拿 53 端口），
# 自动生成配置极易把 DNS 链配错导致断网，留给用户在 LuCI 与各自 Web 界面里按需接。

exit 0
